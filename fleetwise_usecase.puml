@startuml name
left to right direction
skinparam packageStyle rectangle

actor Admin
actor Dispatcher
actor Driver
actor Mechanic
actor System
actor "External Services" as External

rectangle "FleetWise System" {
    usecase "User Login & Authentication" as UC1
    usecase "Manage Vehicles" as UC2
    usecase "Manage Drivers" as UC3
    usecase "Assign Routes" as UC4
    usecase "Real Time GPS Tracking" as UC5
    usecase "Predictive Maintenance Alerts" as UC6
    usecase "Update Maintenance Status" as UC7
    usecase "View Reports" as UC8
    usecase "Subscription & Payments" as UC9
    usecase "Notifications & Alerts" as UC10
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC8
Admin --> UC9

Dispatcher --> UC1
Dispatcher --> UC4
Dispatcher --> UC5
Dispatcher --> UC8

Driver --> UC1
Driver --> UC4

Mechanic --> UC1
Mechanic --> UC6
Mechanic --> UC7

System --> UC6
System --> UC10

External --> UC5
External --> UC9
External --> UC10

UC4 .> UC10 : <<include>>
UC6 .> UC10 : <<extend>>
UC7 .> UC2 : <<extend>>

@enduml
