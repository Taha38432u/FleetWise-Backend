# Server
PORT=5000

# PostgreSQL (Prisma)
# Local example: postgresql://postgres:postgres@localhost:5432/fleetwise
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# JWT
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend + SMTP fallback fields used by config validation)
EMAIL_USER=you@example.com
EMAIL_PASS=your-smtp-or-app-password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=re_xxxxxxxx

# App URLs
APP_NAME=FleetWise
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Stripe test mode (billing)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_SUCCESS_URL=http://localhost:3000/billing?stripe=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?stripe=cancel
